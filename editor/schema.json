{
  "sections": [
    {
      "title": "Mandal details",
      "icon": "✦",
      "description": "Your public name, introduction, location, and contact details. English and Marathi are editable side by side.",
      "fields": [
        {
          "path": [
            "name"
          ],
          "label": "Mandal name",
          "type": "localized",
          "multiline": false
        },
        {
          "path": [
            "about"
          ],
          "label": "About the mandal",
          "type": "localized",
          "multiline": true
        },
        {
          "path": [
            "festivalLabel"
          ],
          "label": "Festival dates or date announcement",
          "type": "localized",
          "multiline": false
        },
        {
          "path": [
            "morningAarti"
          ],
          "label": "Morning aarti time",
          "type": "localized",
          "multiline": false
        },
        {
          "path": [
            "eveningAarti"
          ],
          "label": "Evening aarti time",
          "type": "localized",
          "multiline": false
        },
        {
          "path": [
            "address"
          ],
          "label": "Venue / address",
          "type": "localized",
          "multiline": true
        },
        {
          "path": [
            "mapsUrl"
          ],
          "label": "Google Maps link",
          "type": "url",
          "help": "Optional. Use a link beginning with https://."
        },
        {
          "path": [
            "contactEmail"
          ],
          "label": "Official contact email",
          "type": "email"
        },
        {
          "path": [
            "defaultLanguage"
          ],
          "label": "Default website language",
          "type": "select",
          "options": [
            {
              "value": "en",
              "label": "English"
            },
            {
              "value": "mr",
              "label": "Marathi"
            }
          ]
        },
        {
          "path": [
            "sampleContent"
          ],
          "label": "Show sample-content labels",
          "type": "boolean",
          "help": "Keep this enabled until you have replaced the sample programme, notices, and archive with confirmed information."
        }
      ]
    },
    {
      "collection": "programme",
      "title": "Festival programme",
      "icon": "☀",
      "description": "Add daily events. The website sorts them by day and time, and visitors can filter or download the programme.",
      "fields": [
        {
          "path": [
            "day"
          ],
          "label": "Festival day",
          "type": "number",
          "min": 1,
          "max": 30
        },
        {
          "path": [
            "time"
          ],
          "label": "Event time",
          "type": "time"
        },
        {
          "path": [
            "category"
          ],
          "label": "Event category",
          "type": "select",
          "options": [
            {
              "value": "devotional",
              "label": "Devotional"
            },
            {
              "value": "cultural",
              "label": "Cultural"
            },
            {
              "value": "community",
              "label": "Community"
            }
          ]
        },
        {
          "path": [
            "title"
          ],
          "label": "Event title",
          "type": "localized",
          "multiline": false
        },
        {
          "path": [
            "description"
          ],
          "label": "Event description",
          "type": "localized",
          "multiline": true
        }
      ],
      "template": {
        "id": "",
        "day": 1,
        "time": "19:00",
        "category": "devotional",
        "title": {
          "en": "New event",
          "mr": "नवा कार्यक्रम"
        },
        "description": {
          "en": "",
          "mr": ""
        }
      },
      "addLabel": "Add event"
    },
    {
      "collection": "notices",
      "title": "Announcements",
      "icon": "☷",
      "description": "Publish announcements and notices. The detailed message opens when a visitor selects a notice.",
      "fields": [
        {
          "path": [
            "category"
          ],
          "label": "Notice category",
          "type": "select",
          "options": [
            {
              "value": "festival",
              "label": "Festival"
            },
            {
              "value": "cultural",
              "label": "Cultural"
            },
            {
              "value": "community",
              "label": "Community"
            }
          ]
        },
        {
          "path": [
            "date"
          ],
          "label": "Date or short label",
          "type": "localized",
          "multiline": false
        },
        {
          "path": [
            "title"
          ],
          "label": "Notice title",
          "type": "localized",
          "multiline": false
        },
        {
          "path": [
            "summary"
          ],
          "label": "Short summary",
          "type": "localized",
          "multiline": true
        },
        {
          "path": [
            "body"
          ],
          "label": "Full notice",
          "type": "localized",
          "multiline": true
        }
      ],
      "template": {
        "id": "",
        "category": "festival",
        "date": {
          "en": "New announcement",
          "mr": "नवी सूचना"
        },
        "title": {
          "en": "New notice",
          "mr": "नवी सूचना"
        },
        "summary": {
          "en": "",
          "mr": ""
        },
        "body": {
          "en": "",
          "mr": ""
        }
      },
      "addLabel": "Add announcement"
    },
    {
      "collection": "gallery",
      "title": "Year-wise gallery",
      "icon": "▧",
      "description": "Add real photographs by year. Add an optional video link to each memory. Years appear automatically in the gallery.",
      "fields": [
        {
          "path": [
            "year"
          ],
          "label": "Celebration year",
          "type": "number",
          "min": 1900,
          "max": 2200
        },
        {
          "path": [
            "title"
          ],
          "label": "Memory title",
          "type": "localized",
          "multiline": false
        },
        {
          "path": [
            "category"
          ],
          "label": "Category / occasion",
          "type": "localized",
          "multiline": false
        },
        {
          "path": [
            "image"
          ],
          "label": "Photograph",
          "type": "image"
        },
        {
          "path": [
            "alt"
          ],
          "label": "Image description (for accessibility)",
          "type": "localized",
          "multiline": false
        },
        {
          "path": [
            "description"
          ],
          "label": "Story behind the memory",
          "type": "localized",
          "multiline": true
        },
        {
          "path": [
            "videoUrl"
          ],
          "label": "Optional video link",
          "type": "url"
        }
      ],
      "template": {
        "id": "",
        "year": 2026,
        "title": {
          "en": "New memory",
          "mr": "नवी आठवण"
        },
        "category": {
          "en": "Celebration",
          "mr": "उत्सव"
        },
        "image": "assets/ganpati.svg",
        "alt": {
          "en": "",
          "mr": ""
        },
        "description": {
          "en": "",
          "mr": ""
        },
        "videoUrl": ""
      },
      "addLabel": "Add memory"
    },
